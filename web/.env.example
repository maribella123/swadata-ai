# ---------------------------------------------------------------------------
# SwaData AI — web app environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). The anon/publishable key is safe for the browser;
# all data access is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for rate limiting and processing-service orchestration.
# NEVER expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Python processing service (FastAPI on Render)
PROCESSING_SERVICE_URL=http://127.0.0.1:8000
PROCESSING_SERVICE_TOKEN=

# Deployment stage: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Login attempts allowed per IP per 5 minutes (default 10). Raise only for local E2E runs.
LOGIN_RATE_LIMIT_PER_5MIN=10
# Contact form submissions allowed per IP per hour (default 5).
CONTACT_RATE_LIMIT_PER_HOUR=5
