# SwaData AI processing service — copy to .env for local development.
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret. Never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret; must equal PROCESSING_SERVICE_TOKEN in the web app.
PROCESSING_SERVICE_TOKEN=
APP_ENV=development
WORKER_ENABLED=true
WORKER_POLL_SECONDS=5
OCR_LANG=eng
CORS_ORIGINS=http://localhost:3000
# Optional: enable Whisper-compatible transcription (pip install -r requirements-optional.txt)
WHISPER_MODEL=
WHISPER_DEVICE=cpu
